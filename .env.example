# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git. Never commit real keys.
#
# Public values (safe for the browser, protected by Row Level Security).
# Both are in the Supabase dashboard for your project:
#   Project URL:      the "Connect" button at the top, or Project Settings → Data API
#   Publishable key:  Project Settings → API Keys → "Publishable key" (starts with sb_publishable_)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only secret for the owner Team screen (creating accounts, resetting
# passwords, deactivating). Project Settings → API Keys → "Secret keys"
# (starts with sb_secret_). It bypasses all security rules:
#   - NEVER add a NEXT_PUBLIC_ prefix to this name.
#   - Never paste it into chat, code, docs, or commits.
#   - `npm run cf:build` strips it from the Cloudflare Worker bundle and fails
#     if it appears anywhere in the build output.

SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only Cloudflare R2 settings for photo and video proof
# (docs/SUPABASE_SETUP.md, step 13). The browser never sees these; it only
# receives short-lived signed links for one file at a time.
#   - NEVER add a NEXT_PUBLIC_ prefix to these names.
#   - Never paste the keys into chat, code, docs, or commits.
#   - R2_ACCOUNT_ID:        Cloudflare dashboard → R2 → Account details → Account ID
#   - R2_ACCESS_KEY_ID and
#     R2_SECRET_ACCESS_KEY: shown once when you create the R2 API token
#   - R2_BUCKET:            the private bucket's name

R2_ACCOUNT_ID=replace_me_account_id
R2_ACCESS_KEY_ID=replace_me_access_key_id
R2_SECRET_ACCESS_KEY=replace_me_secret_access_key
R2_BUCKET=armour-ops-media-dev

# Development only (optional): lets a phone on the same Wi-Fi open the dev
# server by this computer's network address, e.g. http://192.168.1.20:3000.
# Put the address `npm run dev` prints as "Network" here, without http:// or
# the port; separate several with commas. Exact hosts only: wildcards are
# ignored. Update it when the address changes, then restart `npm run dev`.
# Production builds ignore it.

DEV_LAN_HOSTS=
