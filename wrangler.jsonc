{
	// Cloudflare Workers configuration for Armour Ops, built with OpenNext
	// (@opennextjs/cloudflare). Production runs on Workers Free at the free
	// workers.dev address; deployments come from GitHub Actions
	// (.github/workflows/deploy.yml). See docs/DEPLOYMENT.md.
	//
	// No secrets or account ids belong here. Runtime secrets (Supabase secret
	// key and R2 settings) are Cloudflare Worker secrets set with
	// `npx wrangler secret put`; the public Supabase URL and publishable key
	// are build-time GitHub Actions variables.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "armour-ops",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"upload_source_maps": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
	// Not added, because every page renders per request and no images are
	// optimized: the R2 incremental cache, the self-reference service binding,
	// and the Images binding from the OpenNext template. Add them only if the
	// app starts using ISR, revalidation, or next/image optimization.
}
